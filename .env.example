# Supabase (local: valores impressos por `npx supabase start`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Somente servidor. Nunca exponha no cliente.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (ata de reunião com IA)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# URL pública do app (links de convite e do portal)
NEXT_PUBLIC_APP_URL=http://localhost:3000
