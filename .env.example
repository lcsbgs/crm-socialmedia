# ------------------------------------------------------------
# Supabase
# ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Somente servidor. Nunca exponha no cliente. Usada no portal do cliente, na prévia de convites,
# nos jobs (fila de publicação, lembretes) e no login por provedor.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública do app (links de convite, portal, callbacks OAuth)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------
# Integrações: "mock" (padrão, tudo simulado) ou "real"
# ------------------------------------------------------------
INTEGRATIONS_MODE=mock
# Segredo do login simulado quando não há service role (só desenvolvimento).
MOCK_AUTH_SECRET=
# Libera e-mail e senha fora do ambiente de desenvolvimento (não recomendado).
ALLOW_PASSWORD_LOGIN=false

# Chave de 32+ caracteres para cifrar tokens de terceiros no banco (AES-256-GCM).
# Gere com: openssl rand -base64 32
ENCRYPTION_KEY=

# Segredo dos jobs agendados (pg_cron/cron externo chamando /api/jobs/*)
CRON_SECRET=

# ------------------------------------------------------------
# IA
# ------------------------------------------------------------
# Sem a chave, a IA responde em modo demonstração.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# ------------------------------------------------------------
# Login e IA com ChatGPT (OpenAI). Ver docs/oauth-setup.md
# ------------------------------------------------------------
OPENAI_OAUTH_CLIENT_ID=
OPENAI_OAUTH_CLIENT_SECRET=
OPENAI_OAUTH_ISSUER=https://auth.openai.com

# ------------------------------------------------------------
# Meta (Facebook e Instagram)
# ------------------------------------------------------------
META_APP_ID=
META_APP_SECRET=
META_CONFIG_ID=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
META_GRAPH_VERSION=v23.0

# ------------------------------------------------------------
# Google (Agenda e Drive)
# ------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_PICKER_API_KEY=
NEXT_PUBLIC_GOOGLE_APP_ID=

# ------------------------------------------------------------
# Canva
# ------------------------------------------------------------
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=

# ------------------------------------------------------------
# Granola (MCP hospedado)
# ------------------------------------------------------------
GRANOLA_MCP_URL=https://mcp.granola.ai/mcp

# ------------------------------------------------------------
# Cobrança e NFS-e (Asaas)
# ------------------------------------------------------------
ASAAS_API_KEY=
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
ASAAS_WEBHOOK_TOKEN=

# ------------------------------------------------------------
# Assinatura de contratos (Clicksign ou ZapSign)
# ------------------------------------------------------------
SIGNATURE_PROVIDER=clicksign
CLICKSIGN_ACCESS_TOKEN=
CLICKSIGN_BASE_URL=https://sandbox.clicksign.com
ZAPSIGN_API_TOKEN=
SIGNATURE_WEBHOOK_TOKEN=

# ------------------------------------------------------------
# E-mail (Resend)
# ------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=
